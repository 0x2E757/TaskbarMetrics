<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Default">
 <Grid.Resources>
  <!--PLAIN-BUTTON-->
  <!-- Switch of the artboards: 40×20 track, 10 px knob off, 12 px knob on, text 10 px after it.
       The system template is wider and reserves 154 px, so the switch never reached the card edge. -->
  <Style TargetType="ToggleSwitch"><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleSwitch">
   <Grid Background="Transparent" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Track.BorderBrush" Value="$disabled$"/><Setter Target="OffKnob.Fill" Value="$disabled$"/><Setter Target="OffLabel.Foreground" Value="$disabled$"/><Setter Target="OnLabel.Foreground" Value="$disabled$"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="ToggleStates"><VisualState x:Name="Dragging"/><VisualState x:Name="Off"/>
      <VisualState x:Name="On"><VisualState.Setters><Setter Target="Track.Background" Value="$accent$"/><Setter Target="Track.BorderBrush" Value="$accent$"/><Setter Target="OffKnob.Visibility" Value="Collapsed"/><Setter Target="OnKnob.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="ContentStates"><VisualState x:Name="OffContent"/>
      <VisualState x:Name="OnContent"><VisualState.Setters><Setter Target="OffLabel.Visibility" Value="Collapsed"/><Setter Target="OnLabel.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="$text2$" Background="Transparent" VerticalAlignment="Center" Control.IsTemplateFocusTarget="True">
     <Grid><Ellipse x:Name="OffKnob" Width="10" Height="10" Margin="4,0,0,0" HorizontalAlignment="Left" Fill="$text2$"/><Ellipse x:Name="OnKnob" Width="12" Height="12" Margin="23,0,0,0" HorizontalAlignment="Left" Fill="$onAccent$" Visibility="Collapsed"/></Grid>
    </Border>
    <ContentPresenter x:Name="OffLabel" Grid.Column="1" Content="{TemplateBinding OffContent}" Foreground="$text$" FontSize="13" VerticalAlignment="Center"/>
    <ContentPresenter x:Name="OnLabel" Grid.Column="1" Content="{TemplateBinding OnContent}" Foreground="$text$" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter></Style>
  <!-- Segoe UI Variable sets capitals about 0.05 em above the centre of the line box; 1 px puts them on the centre of icons and controls at 11–15 px. -->
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="$text$"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="13"/><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Style>
  <Style x:Key="PreviewText" TargetType="TextBlock"><Setter Property="Foreground" Value="$text$"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="Button"><Setter Property="Template" Value="{StaticResource PlainButton}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="$ctrl$"/><Setter Property="Foreground" Value="$text$"/><Setter Property="BorderBrush" Value="$ctrlBorder$"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <x:Double x:Key="TextControlThemeMinHeight">30</x:Double>
  <Style TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="8,5,8,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Slider">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid x:Name="SliderContainer" Background="Transparent">
      <Grid x:Name="HorizontalTemplate" Height="20" VerticalAlignment="Center">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="4" RadiusX="2" RadiusY="2" Fill="$sliderTrack$"/>
       <Rectangle x:Name="HorizontalDecreaseRect" Height="4" RadiusX="2" RadiusY="2" Fill="$accent$"/>
       <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="20" Height="20" DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent">
         <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Dot.Width" Value="14"/><Setter Target="Dot.Height" Value="14"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Dot.Width" Value="10"/><Setter Target="Dot.Height" Value="10"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Dot.Fill" Value="$disabled$"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
         <Ellipse Fill="$card$" Stroke="$ctrlBorder$" StrokeThickness="1"/><Ellipse x:Name="Dot" Width="12" Height="12" Fill="$accent$"/>
        </Grid></ControlTemplate></Thumb.Template>
       </Thumb>
      </Grid>
      <Grid x:Name="VerticalTemplate" Visibility="Collapsed"><Rectangle x:Name="VerticalTrackRect"/><Rectangle x:Name="VerticalDecreaseRect"/><Thumb x:Name="VerticalThumb"/></Grid>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <!-- Only the thumb of an alert threshold; the track is painted by AlertRange underneath. -->
  <Style x:Key="RangeThumb" TargetType="Slider">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid x:Name="SliderContainer">
      <Grid x:Name="HorizontalTemplate" Height="20" VerticalAlignment="Top">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="4"/>
       <Rectangle x:Name="HorizontalDecreaseRect" Height="4"/>
       <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="20" Height="20" DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent">
         <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Dot.Width" Value="14"/><Setter Target="Dot.Height" Value="14"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Dot.Width" Value="10"/><Setter Target="Dot.Height" Value="10"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups>
         <Ellipse Fill="$card$" Stroke="$ctrlBorder$" StrokeThickness="1"/><Ellipse x:Name="Dot" Width="12" Height="12" Fill="$accent$"/>
        </Grid></ControlTemplate></Thumb.Template>
       </Thumb>
      </Grid>
      <Grid x:Name="VerticalTemplate" Visibility="Collapsed"><Rectangle x:Name="VerticalTrackRect"/><Rectangle x:Name="VerticalDecreaseRect"/><Thumb x:Name="VerticalThumb"/></Grid>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="ExpanderButton" TargetType="Button"><Setter Property="Template" Value="{StaticResource PlainButton}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="62"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style x:Key="TabButton" TargetType="Button"><Setter Property="Template" Value="{StaticResource PlainButton}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="4,4,0,0"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
  <Style x:Key="MenuItem" TargetType="Button"><Setter Property="Template" Value="{StaticResource PlainButton}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="32"/></Style>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="$ctrlHover$"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="$ctrlPress$"/>
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="$text$"/>
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="$text2$"/>
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="$ctrlBorder$"/>
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="$ctrlBorder$"/>
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="$subtle$"/>
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="$disabled$"/>
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="$subtle$"/>
  <SolidColorBrush x:Key="TextControlBackground" Color="$ctrl$"/>
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="$ctrlHover$"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="$card$"/>
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="$subtle$"/>
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="$ctrlBorder$"/>
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="$ctrlBorder$"/>
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="$accent$"/>
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="$divider$"/>
  <SolidColorBrush x:Key="TextControlForeground" Color="$text$"/>
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="$text$"/>
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="$text$"/>
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="$text2$"/>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Text="@Settings@" FontSize="28" FontWeight="SemiBold" LineHeight="37" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,8"/>
 <!-- Tabs: the active one has its text in 600 and an accent line over the divider; an invisible 600 copy keeps each tab as wide in both states. -->
 <Grid Grid.Row="1" Margin="0,0,0,14" BorderBrush="$divider$" BorderThickness="0,0,0,1">
  <StackPanel Orientation="Horizontal" Spacing="4">
   <Button x:Name="TabGeneral" Style="{StaticResource TabButton}" AutomationProperties.Name="@General@"><Grid><TextBlock Text="@General@" FontSize="14" FontWeight="SemiBold" Foreground="Transparent" VerticalAlignment="Center"/><TextBlock x:Name="TabGeneralOn" Text="@General@" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TabGeneralOff" Visibility="Collapsed" Text="@General@" FontSize="14" Foreground="$text2$" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="TabGeneralLine" Height="3" CornerRadius="1.5" Background="$accent$" VerticalAlignment="Bottom"/></Grid></Button>
   <Button x:Name="TabTaskbar" Style="{StaticResource TabButton}" AutomationProperties.Name="@Taskbar@"><Grid><TextBlock Text="@Taskbar@" FontSize="14" FontWeight="SemiBold" Foreground="Transparent" VerticalAlignment="Center"/><TextBlock x:Name="TabTaskbarOn" Visibility="Collapsed" Text="@Taskbar@" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TabTaskbarOff" Text="@Taskbar@" FontSize="14" Foreground="$text2$" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="TabTaskbarLine" Visibility="Collapsed" Height="3" CornerRadius="1.5" Background="$accent$" VerticalAlignment="Bottom"/></Grid></Button>
  </StackPanel>
 </Grid>
 <Border x:Name="TaskbarPreview" Visibility="Collapsed" Grid.Row="2" Background="$card$" BorderBrush="$border$" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
  <StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,12,16,0">
    <TextBlock Text="@Tile preview@" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="@100 % scale, both themes@" FontSize="12" Foreground="$text2$" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Padding="16,10,16,12" Spacing="8">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="@Light@" FontSize="11" Foreground="$text3$" VerticalAlignment="Center"/>
     <Border Grid.Column="1" Height="48" CornerRadius="6" Background="#EEF1F6" BorderBrush="#DDE1E7" BorderThickness="1" Padding="6,0" RequestedTheme="Light">
      <Border.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource PreviewText}"/></Border.Resources>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalAlignment="Center"><StackPanel x:Name="LightPreview" Orientation="Horizontal" MinHeight="36"/></ScrollViewer>
       <Border Grid.Column="1" Width="24" Height="24" CornerRadius="6" Background="#14000000"/>
      </Grid>
     </Border>
    </Grid>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="@Dark@" FontSize="11" Foreground="$text3$" VerticalAlignment="Center"/>
     <Border Grid.Column="1" Height="48" CornerRadius="6" Background="#1F1F1F" BorderBrush="#2E2E2E" BorderThickness="1" Padding="6,0" RequestedTheme="Dark">
      <Border.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource PreviewText}"/></Border.Resources>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalAlignment="Center"><StackPanel x:Name="DarkPreview" Orientation="Horizontal" MinHeight="36"/></ScrollViewer>
       <Border Grid.Column="1" Width="24" Height="24" CornerRadius="6" Background="#1FFFFFFF"/>
      </Grid>
     </Border>
    </Grid>
    <StackPanel x:Name="PreviewNotes" Orientation="Horizontal" Spacing="16" Margin="68,1,0,1"/>
   </StackPanel>
   <StackPanel Padding="16,10,16,12" Spacing="8" BorderBrush="$divider$" BorderThickness="0,1,0,0">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <TextBlock Text="@Preview values@" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock Text="@used only in the preview@" FontSize="12" Foreground="$text2$"/>
     </StackPanel>
     <Border Grid.Column="2" Background="$subtle$" BorderBrush="$divider$" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="PreviewTest" Padding="0" MinHeight="0" BorderThickness="0" Background="Transparent"/><Button x:Name="PreviewLive" Padding="0" MinHeight="0" BorderThickness="0" Background="Transparent"/></StackPanel></Border>
    </Grid>
    @DEMO@
   </StackPanel>
   <Grid Padding="16,10" ColumnSpacing="10" BorderBrush="$divider$" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="PendingState" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <Ellipse x:Name="PendingDot" Width="8" Height="8" Fill="$statusDot$" VerticalAlignment="Center"/>
     <TextBlock x:Name="ApplyStatus" FontSize="12" Foreground="$text2$" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <!-- Shown as soon as the pointer enters the icon; the card grows up and to the left from it, over the preview values. -->
    <Grid x:Name="ApplyHintTarget" Grid.Column="1" Background="Transparent" Padding="2" VerticalAlignment="Center" AutomationProperties.Name="@“Apply to taskbar” saves the tile appearance; the taskbar picks it up within a second.@ @“Revert changes” returns the tile settings to the last applied ones.@">$icon:info:14:1.3:text3$
     <Canvas><Grid Canvas.Left="-302" Canvas.Top="-246" Width="320" Height="240" IsHitTestVisible="False"><Border x:Name="ApplyHintCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,5,8,6" CornerRadius="4" Background="$card$" BorderBrush="$border$" BorderThickness="1"><StackPanel Spacing="4">
      <TextBlock Text="@“Apply to taskbar” saves the tile appearance; the taskbar picks it up within a second.@" FontSize="12" TextWrapping="Wrap"/>
      <TextBlock Text="@“Revert changes” returns the tile settings to the last applied ones.@" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel></Border></Grid></Canvas>
    </Grid>
    <Grid Grid.Column="2">
     <Button x:Name="Revert"><StackPanel Orientation="Horizontal" Spacing="8">$icon:reset:16:1.3:text$<TextBlock Text="@Revert changes@" VerticalAlignment="Center"/></StackPanel></Button>
     <Border x:Name="RevertIdle" Visibility="Collapsed" Height="32" CornerRadius="4" Background="$subtle$" Padding="12,0" BorderBrush="$subtle$" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="8">$icon:reset:16:1.3:disabled$<TextBlock Text="@Revert changes@" Foreground="$disabled$" VerticalAlignment="Center"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Column="3">
     <Button x:Name="Apply" Background="$accent$" Foreground="$onAccent$" BorderBrush="$accent$">
      <Button.Resources>
       <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="$accentHover$"/>
       <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="$accentPress$"/>
       <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="$accentHover$"/>
       <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="$accentPress$"/>
       <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="$onAccent$"/>
       <SolidColorBrush x:Key="ButtonForegroundPressed" Color="$onAccent$"/>
      </Button.Resources>
      <StackPanel Orientation="Horizontal" Spacing="8">$icon:check:16:1.3:onAccent$<TextBlock Text="@Apply to taskbar@" Foreground="$onAccent$" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Border x:Name="ApplyIdle" Visibility="Collapsed" Height="32" CornerRadius="4" Background="$subtle$" Padding="12,0" BorderBrush="$subtle$" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="8">$icon:check:16:1.3:disabled$<TextBlock Text="@Apply to taskbar@" Foreground="$disabled$" VerticalAlignment="Center"/></StackPanel></Border>
    </Grid>
   </Grid>
  </StackPanel>
 </Border>
 <!-- The scroll bar sits in the page margin, so the sections line up with the preview card. -->
 <ScrollViewer x:Name="TaskbarScroll" Visibility="Collapsed" Grid.Row="3" Margin="0,0,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <ScrollViewer.Resources><!--SCROLL-INDICATOR--></ScrollViewer.Resources>
  <StackPanel Spacing="4" Padding="0,0,12,8">
   <TextBlock Text="@Tile appearance@" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
   @EXPANDER0@
   @EXPANDER1@
   @EXPANDER2@
   @EXPANDER3@
   <TextBlock Text="@Alerts@" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
   @EXPANDER4@
   @EXPANDER5@
  </StackPanel>
 </ScrollViewer>
 <ScrollViewer x:Name="GeneralScroll" Grid.Row="2" Grid.RowSpan="2" Margin="0,0,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <ScrollViewer.Resources><!--SCROLL-INDICATOR--></ScrollViewer.Resources>
  <StackPanel Spacing="4" Padding="0,0,12,8">
   <TextBlock Text="@Startup and window@" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <Border Background="$card$" BorderBrush="$border$" BorderThickness="1" CornerRadius="6">
    <StackPanel>
     <Grid MinHeight="64" Padding="16,10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      $icon:power:16:1.3:text2$
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
       <CheckBox x:Name="Autostart" AutomationProperties.Name="@Start when signing in to Windows@"><TextBlock Text="@Start when signing in to Windows@"/></CheckBox>
       <TextBlock x:Name="AutostartStatus" Text="@Taskbar tiles and the CPU temperature sensor@" FontSize="12" Foreground="$text2$" Margin="28,0,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
     <Grid MinHeight="64" Padding="16,10" ColumnSpacing="16" BorderBrush="$divider$" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      $icon:layout:16:1.3:text2$
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
       <CheckBox x:Name="ResetWindow" AutomationProperties.Name="@Reset the window size and position when it closes@"><TextBlock Text="@Reset the window size and position when it closes@"/></CheckBox>
       <TextBlock x:Name="ResetWindowStatus" FontSize="12" Foreground="$text2$" Margin="28,0,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <TextBlock Text="@Taskbar tiles@" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
   <Grid MinHeight="64" Padding="16,10" ColumnSpacing="16" Background="$card$" BorderBrush="$border$" BorderThickness="1" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid VerticalAlignment="Top" Margin="0,2,0,0">$icon:monitor:16:1.3:text2$</Grid>
    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
     <TextBlock Text="@Monitors@"/>
     <TextBlock x:Name="MonitorsStatus" Text="@If none of the chosen monitors is connected, the tiles show on the main one@" FontSize="12" Foreground="$text2$" TextWrapping="Wrap"/>
     <StackPanel Spacing="2" Margin="0,6,0,0">@MONITORS@</StackPanel>
    </StackPanel>
   </Grid>
   <TextBlock Text="@Monitoring@" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
   <Grid MinHeight="64" Padding="16,10" ColumnSpacing="16" Background="$card$" BorderBrush="$border$" BorderThickness="1" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    $icon:history:16:1.3:text2$
    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
     <TextBlock Text="@Background process history@"/>
     <TextBlock x:Name="MonitoringStatus" Text="@Collect process usage while the window is closed. 5 min at 0.5 s.@" FontSize="12" Foreground="$text2$" TextWrapping="Wrap"/>
    </StackPanel>
    <ToggleSwitch x:Name="ProcessMonitoring" Grid.Column="2" OnContent="@On@" OffContent="@Off@" VerticalAlignment="Center"/>
   </Grid>
   <TextBlock Text="@Window appearance@" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
   <Border Background="$card$" BorderBrush="$border$" BorderThickness="1" CornerRadius="6">
    <StackPanel>
     <Grid MinHeight="64" Padding="16,10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      $icon:palette:16:1.3:text2$
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
       <TextBlock Text="@Window theme@"/>
       <TextBlock Text="@“System” follows the Windows app theme@" FontSize="12" Foreground="$text2$" TextWrapping="Wrap"/>
      </StackPanel>
      <Button x:Name="ThemePicker" Grid.Column="2" MinWidth="160" Padding="12,0,10,0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="@Window theme@">
       <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ThemeName" VerticalAlignment="Center"/><Grid Grid.Column="1">$icon:chev:14:1.3:text2$</Grid></Grid>
       <Button.Flyout><Flyout x:Name="ThemeFlyout" Placement="BottomEdgeAlignedRight"><Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Background" Value="$card$"/><Setter Property="BorderBrush" Value="$border$"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/><Setter Property="CornerRadius" Value="8"/><Setter Property="MinWidth" Value="160"/></Style></Flyout.FlyoutPresenterStyle>
        <StackPanel Width="160" Spacing="2"><Button x:Name="ThemeSystem" Style="{StaticResource MenuItem}"/><Button x:Name="ThemeLight" Style="{StaticResource MenuItem}"/><Button x:Name="ThemeDark" Style="{StaticResource MenuItem}"/></StackPanel>
       </Flyout></Button.Flyout>
      </Button>
     </Grid>
     @CHARTLINE@
    </StackPanel>
   </Border>
   <TextBlock Text="@Language@" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
   <Grid MinHeight="64" Padding="16,10" ColumnSpacing="16" Background="$card$" BorderBrush="$border$" BorderThickness="1" CornerRadius="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    $icon:globe:16:1.3:text2$
    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
     <TextBlock Text="@Display language@"/>
     <TextBlock Text="@Applies immediately, no restart needed@" FontSize="12" Foreground="$text2$"/>
    </StackPanel>
    <Button x:Name="LanguagePicker" Grid.Column="2" MinWidth="160" Padding="12,0,10,0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="@Language@">
