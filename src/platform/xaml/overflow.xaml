<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="@WIDTH@" Height="36" Background="Transparent" Visibility="Collapsed">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="MetricOverflow" Color="#FCE100"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MetricOverflow" Color="#9D5D00"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="MetricOverflow" Color="{ThemeResource SystemColorWindowTextColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <ToolTipService.ToolTip>
    <ToolTip>
      <TextBlock x:Name="OverflowText" TextWrapping="Wrap"/>
    </ToolTip>
  </ToolTipService.ToolTip>
  <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
            Foreground="{ThemeResource MetricOverflow}"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Grid>
