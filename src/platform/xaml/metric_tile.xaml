<Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="@WIDTH@" Height="36" MinWidth="0" MinHeight="0" Padding="0"
        IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False"
        AutomationProperties.Name="@LABEL@">
  <Button.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <Color x:Key="MetricAreaFaded">#@FADE_ALPHA@60CDFF</Color><Color x:Key="MetricArea">#60CDFF</Color><Color x:Key="MetricAccentFaded">#@FADE_ALPHA@60CDFF</Color><Color x:Key="SecondaryFaded">#@FADE_ALPHA@@SECONDARY_DARK@</Color><Color x:Key="MetricAccent">#60CDFF</Color><Color x:Key="MetricUpload">#C3A6FF</Color>
          <Color x:Key="MetricTemperature">#FFB454</Color>
          <SolidColorBrush x:Key="MetricTile" Color="#0FFFFFFF"/>
          <SolidColorBrush x:Key="MetricForeground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MetricDim" Color="#A3A3A3"/>
          <SolidColorBrush x:Key="MetricTemperatureText" Color="#FFB454"/><SolidColorBrush x:Key="MetricHot" Color="#FFB454"/>
          <SolidColorBrush x:Key="MetricUp" Color="#C3A6FF"/>
          <SolidColorBrush x:Key="MetricDown" Color="#60CDFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="MetricAreaFaded">#@FADE_ALPHA@005FB8</Color><Color x:Key="MetricArea">#005FB8</Color><Color x:Key="MetricAccentFaded">#@FADE_ALPHA@005FB8</Color><Color x:Key="SecondaryFaded">#@FADE_ALPHA@@SECONDARY_LIGHT@</Color><Color x:Key="MetricAccent">#005FB8</Color><Color x:Key="MetricUpload">#6B3FD4</Color>
          <Color x:Key="MetricTemperature">#A34F00</Color>
          <SolidColorBrush x:Key="MetricTile" Color="#0B000000"/>
          <SolidColorBrush x:Key="MetricForeground" Color="#1A1A1A"/>
          <SolidColorBrush x:Key="MetricDim" Color="#5D5D5D"/>
          <SolidColorBrush x:Key="MetricTemperatureText" Color="#A34F00"/><SolidColorBrush x:Key="MetricHot" Color="#A34F00"/>
          <SolidColorBrush x:Key="MetricUp" Color="#6B3FD4"/>
          <SolidColorBrush x:Key="MetricDown" Color="#005FB8"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <Color x:Key="MetricAreaFaded">#@FADE_ALPHA@FFFFFF</Color><Color x:Key="MetricArea">#FFFFFF</Color><Color x:Key="MetricAccentFaded">#@FADE_ALPHA@FFFFFF</Color><Color x:Key="SecondaryFaded">#@FADE_ALPHA@FFFF00</Color><Color x:Key="MetricAccent">#FFFFFF</Color>
          <Color x:Key="MetricUpload">#FFFF00</Color>
          <Color x:Key="MetricTemperature">#FFFF00</Color>
          <SolidColorBrush x:Key="MetricTile" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="MetricForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="MetricDim" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="MetricTemperatureText" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="MetricHot" Color="{ThemeResource SystemColorHighlightColor}"/>
          <SolidColorBrush x:Key="MetricUp" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="MetricDown" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Button.Resources>
  <Button.RenderTransform><TranslateTransform x:Name="Shift"/></Button.RenderTransform>
  <Button.Template>
    <ControlTemplate TargetType="Button">
      <Grid>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="PointerOver"><VisualState.Setters>
              <Setter Target="Hover.Background" Value="{ThemeResource OmniButtonBackgroundPointerOver}"/>
            </VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters>
              <Setter Target="Hover.Background" Value="{ThemeResource OmniButtonBackgroundPressed}"/>
            </VisualState.Setters></VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border Background="{ThemeResource MetricTile}" CornerRadius="5"/>
        <Border x:Name="Hover" Background="Transparent" CornerRadius="5"/>
        <ContentPresenter Content="{TemplateBinding Content}"/>
      </Grid>
    </ControlTemplate>
  </Button.Template>
  <Grid Width="@WIDTH@" Height="36" IsHitTestVisible="False">
    <Grid.Resources>
      <Storyboard x:Name="AlertPulse" x:Key="AlertPulse">
        <DoubleAnimation Storyboard.TargetName="AlertBackground" Storyboard.TargetProperty="Opacity" From="@ALERT_MAX@" To="@ALERT_MIN@" Duration="0:0:@ALERT_HALF_PERIOD@" AutoReverse="True" RepeatBehavior="Forever"/>
      </Storyboard>
      <Storyboard x:Name="Slide" x:Key="Slide">
        <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" Duration="0:0:0.2">
          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
      </Storyboard>
    </Grid.Resources>
    <Grid.Clip><RectangleGeometry Rect="0,0,@WIDTH@,36"/></Grid.Clip>
    <Border x:Name="AlertBackground" Background="#FFFF0000" CornerRadius="5" Opacity="0"/>
    <Canvas x:Name="Chart" Width="@WIDTH@" Height="36">
      <Polygon x:Name="Area" Opacity="0.22">
        <Polygon.Fill><LinearGradientBrush x:Name="AreaFade" StartPoint="0.44,0" EndPoint="0.67,0">
          <GradientStop Color="{ThemeResource MetricAreaFaded}" Offset="0"/><GradientStop Color="{ThemeResource MetricArea}" Offset="1"/>
        </LinearGradientBrush></Polygon.Fill>
      </Polygon>
      <Polyline x:Name="Line" StrokeThickness="1.25" StrokeLineJoin="Round">
        <Polyline.Stroke><LinearGradientBrush x:Name="LineFade" StartPoint="0.44,0" EndPoint="0.67,0">
          <GradientStop Color="{ThemeResource MetricAccentFaded}" Offset="0"/><GradientStop Color="{ThemeResource MetricAccent}" Offset="1"/>
        </LinearGradientBrush></Polyline.Stroke>
      </Polyline>
      <Polyline x:Name="Upload" StrokeThickness="1.25" StrokeLineJoin="Round">
        <Polyline.Stroke><LinearGradientBrush x:Name="UploadFade" StartPoint="0.44,0" EndPoint="0.67,0">
          <GradientStop Color="{ThemeResource SecondaryFaded}" Offset="0"/><GradientStop Color="{ThemeResource @SECONDARY_COLOR@}" Offset="1"/>
        </LinearGradientBrush></Polyline.Stroke>
      </Polyline>
    </Canvas>
    <Grid x:Name="TextGroup" HorizontalAlignment="Left" Margin="6,2,0,2">
      <TextBlock Text="@LABEL@" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="9" FontWeight="SemiBold"
                 CharacterSpacing="70" Foreground="{ThemeResource MetricDim}" VerticalAlignment="Top"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="3">
        <StackPanel.RenderTransform><TranslateTransform X="-1" Y="-1"/></StackPanel.RenderTransform>
        @PREFIX@
        <Grid>
          <TextBlock x:Name="Value" Text="--" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MetricForeground}"/>
          <TextBlock x:Name="HotValue" Text="--" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MetricHot}" Visibility="Collapsed"/>
        </Grid>
        <TextBlock x:Name="Secondary" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,1"
                   Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource @SECONDARY_BRUSH@}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Button>
